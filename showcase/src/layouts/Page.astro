---
import { snapshot, snapshotHash } from '../catalog/load';
import '../styles/catalog.css';
interface Props { title: string; description?: string; }
const { title, description = 'Browse the Halcyon Video selection of films and series.' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · Halcyon Video</title><meta name="description" content={description} /><meta name="robots" content="noindex, nofollow" /><meta name="halcyon-snapshot" content={snapshotHash} />{canonical && <link rel="canonical" href={canonical} />}</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead"><a class="brand" href="/" aria-label="Halcyon Video home">HALCYON <span>VIDEO</span></a><nav aria-label="Main"><a href="/browse/">Browse</a><a href="/about/">About</a><a href="/store/">3D store</a></nav></header>
  <main id="main" tabindex="-1"><p class="preview">Development preview · fictional sample titles</p><slot /></main>
  <footer><p>Curated selection · United States</p><p>Fixture date: <time datetime={snapshot.checkedAt}>{snapshot.checkedAt.slice(0,10)}</time>. No live availability claims.</p><a href="/self-host/">Make it your own</a></footer>
  <script>import '../browser/catalog';</script>
</body></html>
