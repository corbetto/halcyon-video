---
import Page from '../../layouts/Page.astro';
import Catalog from '../../components/Catalog.astro';
import {snapshot} from '../../catalog/load';
import {PAGE_SIZE} from '../../catalog/browse';
export function getStaticPaths(){
  return (['all','movie','tv'] as const).flatMap(kind=>{
    const titles=snapshot.titles.filter(title=>kind==='all'||title.mediaType===kind),total=Math.max(1,Math.ceil(titles.length/PAGE_SIZE));
    return Array.from({length:total},(_,i)=>({params:{page:[kind==='movie'?'movies':kind==='tv'?'tv':'',i?String(i+1):''].filter(Boolean).join('/')||undefined},props:{titles:titles.slice(i*PAGE_SIZE,(i+1)*PAGE_SIZE),kind,page:i+1,total,count:titles.length}}));
  });
}
const {titles,kind,page,total,count}=Astro.props;
---
<Page title={kind==='movie'?'Movies':kind==='tv'?'Series':'Browse movies and series'}><h1>Find your next good watch.</h1><Catalog titles={titles} kind={kind} page={page} total={total} count={count}/></Page>
