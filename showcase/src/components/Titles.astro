---
import type { CatalogTitle } from '../catalog/schema';
import { titlePath } from '../catalog/schema';
import { snapshot } from '../catalog/load';
import Poster from './Poster.astro';
interface Props { titles: CatalogTitle[]; }
const { titles } = Astro.props;
---
<ul class="cards" id="catalog-results">{titles.map((title,index)=><li><a class="card" data-title-key={`${title.mediaType}:${title.tmdbId}`} href={titlePath(title)}><Poster title={title} source={snapshot.source} priority={index<2}/><h2>{title.title}</h2><p class="meta">{title.mediaType==='tv'?'Series':'Movie'} · {title.year??'Year unknown'}</p></a></li>)}</ul>
